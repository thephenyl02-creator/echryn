ECHRYN_API_KEY=change-me
ECHRYN_PUBLIC_BASE_URL=http://localhost:8080
ECHRYN_DATA_DIR=/tmp/echryn
ECHRYN_CACHE_TTL_SECONDS=604800
ECHRYN_MAX_MEDIA_MB=80
ECHRYN_MAX_FRAMES=12
ECHRYN_EVIDENCE_MAX_FRAMES=6
ECHRYN_FRAME_WEBP_QUALITY=70
ECHRYN_FRAME_MAX_WIDTH=640
ECHRYN_FRAME_URL_TTL_SECONDS=604800
ECHRYN_SCENE_THRESHOLD=0.24
ECHRYN_SCENE_MIN_GAP_SECONDS=0.6
ECHRYN_MODE_DEFAULT=auto

# Local audio pipeline
ECHRYN_SPEECH_MODEL=base
ECHRYN_SPEECH_DEVICE=cpu
ECHRYN_SPEECH_COMPUTE_TYPE=int8
ECHRYN_WHISPER_BEAM_SIZE=1
ECHRYN_VAD_THRESHOLD=0.55
ECHRYN_VAD_MIN_SPEECH_MS=350
ECHRYN_VAD_MIN_SILENCE_MS=300
ECHRYN_VAD_SPEECH_PAD_MS=150
ECHRYN_MIN_TOTAL_SPEECH_SECONDS=0.6

# Instagram service-session credentials. Prefer a dedicated company-owned account.
# Treat these as password-equivalent secrets. Never commit them.
INSTAGRAM_SESSIONID=
INSTAGRAM_CSRFTOKEN=
INSTAGRAM_DS_USER_ID=
INSTAGRAM_USER_AGENT=Mozilla/5.0

# Echryn Core has no mandatory paid vision or speech API dependency.
