ECHRYN_API_KEY=change-me
ECHRYN_PUBLIC_BASE_URL=http://localhost:8080
ECHRYN_DATA_DIR=/tmp/echryn
ECHRYN_CACHE_TTL_SECONDS=604800
ECHRYN_MAX_MEDIA_MB=80
ECHRYN_MAX_FRAMES=12
ECHRYN_MODE_DEFAULT=auto

# Instagram service-session credentials. Prefer a dedicated company-owned account.
# Treat these as password-equivalent secrets. Never commit them.
INSTAGRAM_SESSIONID=
INSTAGRAM_CSRFTOKEN=
INSTAGRAM_DS_USER_ID=
INSTAGRAM_USER_AGENT=Mozilla/5.0

# Optional hosted vision adapter. Provider must accept JSON with images as base64 data URLs.
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=

# Optional hosted speech adapter. Provider-specific wrapper URL.
SPEECH_API_URL=
SPEECH_API_KEY=
SPEECH_MODEL=
